<?xml version="1.0" encoding="utf-8"?>
<!-- 主页：只做状态展示。中间大 logo，下方状态灯 + 阶段文字 + 三步使用指南，右上角进入设置。
     背景与 logo 的四角米色一致，让猫头看起来是浮在页面上而不是贴了一张方图。
     竖向用两个等权重占位（下大于上）把内容整体抬到中线偏上，页面不滚动。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- 上方留白：权重小于下方，重心因此上移 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="248dp"
            android:layout_height="248dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_cat" />

        <!-- 状态指示器：圆点颜色即状态（红=未启动 / 黄=接入中 / 绿=监听或对话） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/home_state_idle"
                android:textColor="@color/home_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 使用指南：三步，没有按钮也没有开关，只看不点 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_home_guide"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_guide_title"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingExtra="9dp"
                android:text="@string/home_guide_body"
                android:textColor="@color/home_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 下方留白：权重约为上方两倍，整体重心停在中线之上 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />
    </LinearLayout>

    <!-- 设置入口：右上角齿轮 -->
    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/title_settings"
        android:padding="14dp"
        android:src="@drawable/ic_settings" />
</FrameLayout>
